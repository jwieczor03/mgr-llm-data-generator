# Parametry Compose i inicjalizacji nowej bazy aplikacji. Plik lokalny: .env.
# Wpisz własne hasło. Brak hasła uniemożliwia inicjalizację PostgreSQL.
POSTGRES_DB=generator
POSTGRES_USER=generator
POSTGRES_PASSWORD=
# Te ustawienia inicjalizują pusty wolumen; nie zmieniają istniejących kont.
# application-api ma osobne APP_DB_* w services/application-api/.env.
