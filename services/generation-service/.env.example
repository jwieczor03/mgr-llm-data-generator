# Lokalne ustawienia serwisu. Zmiana wymaga restartu.
# Brak wymaganych zmiennych na tym etapie.

# Opcjonalny adapter (pozostaw zakomentowane, aby nie aktywować LLM):
# LLM_BACKEND=ollama
# LLM_BASE_URL=http://127.0.0.1:11434
# LLM_TRUSTED_LOCAL=false
# Dla backendu external podaj również LLM_API_KEY w bezpiecznej konfiguracji.
